# URL de la implementación web de Google Apps Script.
# Si no se define, la app usa la URL de respaldo configurada en src/config/app.js.
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REEMPLAZAR/exec

# Lectura frontend ROP02. Usar solamente URL y clave publishable/anon.
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_PUBLISHABLE_O_ANON

# supabase (normal) o legacy (rollback temporal).
VITE_ROP02_SOURCE=supabase
